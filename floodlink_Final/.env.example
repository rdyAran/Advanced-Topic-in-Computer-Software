# คัดลอกเป็น .env — ห้ามวาง key ในแชตหรือ commit ขึ้น git
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# เว้นว่าง = เลือกรุ่นอัตโนมัติ (แนะนำระบุ เช่น gemini-3.5-flash เพราะรุ่นใหม่สุดมักคนใช้เยอะ)
GEMINI_MODEL=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# strict JSON schema ได้กับ openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# ลำดับ LLM ที่ลอง (ตัวไหนล่ม/โควตาหมด ข้ามไปตัวถัดไป และพักตัวนั้น 60 วิ)
LLM_PROVIDERS=gemini,groq
# hybrid (แนะนำ) | own | llm | gemini | groq | rules
AGENT_STRATEGY=hybrid
# โมเดลของเรามั่นใจต่ำกว่านี้ -> ส่งต่อ LLM (0-1)
ESCALATE_THRESHOLD=0.5
# 1 = ปิดบังเบอร์ บ้านเลขที่ พิกัด ลิงก์ อีเมล ไลน์ เลขบัตร ชื่อ ก่อนส่งข้อความให้ LLM ภายนอก (แนะนำ)
LLM_MASK_PII=1
# Own model: auto = WangchanBERTa if 04_flood_nlp_model/artifacts/floodwcb_model/model.pt exists, else v1 (scikit-learn)
#            wcb  = WangchanBERTa only (agent fails to start if the model is missing)   v1 = small model only
OWN_MODEL=auto
WCB_THREADS=2
# ลิงก์หน้าเว็บที่แชทบอทใส่ในคำตอบ (เปลี่ยนเป็นโดเมนจริงตอน deploy)
PUBLIC_WEB_URL=http://localhost:5173
# 1 = ลิงก์ย่อ maps.app.goo.gl ที่ผู้แจ้งส่งมา ระบบถาม Google ว่าชี้ไปพิกัดไหน (ปักหมุดได้แม่น) · 0 = ไม่ต่อเน็ต ใช้ลิงก์ตามเดิม
RESOLVE_MAP_LINKS=1
# 1 = แชทบอทใช้ LLM ช่วยจัดประเภทคำถามและเรียบเรียงคำตอบจากคลังความรู้ / 0 = ใช้กฎอย่างเดียว
CHAT_USE_LLM=1

# ---- บัญชีผู้ใช้ / ล็อกอิน ----
# รหัสผ่านของบัญชีเดโม admin / officer / boat1 / boat2 ที่สร้างตอนเปิดครั้งแรก (อย่างน้อย 8 ตัว)
# เว้นว่าง = สุ่มให้ แล้วพิมพ์ไว้ใน log ของ api ครั้งเดียว (docker compose logs api)
SEED_PASSWORD=
# กุญแจเซ็น session (เว้นว่าง = สุ่มเก็บในฐานข้อมูล) ; ใส่เองได้ เช่น ผลจาก python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
SESSION_HOURS=12
# เขตเวลา (ชั่วโมงจาก UTC) ที่ระบบบันทึกเวลา — ไทย = 7
APP_UTC_OFFSET=7
# เวลาในฐานข้อมูลเก่าที่ไม่มี +07:00 บันทึกเป็นเขตไหน: 0 = UTC (รันใน Docker) · 7 = รัน API บนเครื่อง Windows โดยตรง
LEGACY_TZ_OFFSET=0
# 1 เมื่อเปิดผ่าน https จริง (cookie จะส่งเฉพาะ https)
COOKIE_SECURE=0
# ชุดไม่ตอบรับเคสเกินกี่นาทีจึงเตือนศูนย์
ACCEPT_MINUTES=10

# ---- Facebook Page webhook (ไม่บังคับ) — ดู docs/FACEBOOK_WEBHOOK.md ----
FB_VERIFY_TOKEN=floodlink-dev
FB_APP_SECRET=
FB_PAGE_TOKEN=
FB_AUTO_REPLY=1
FB_REPLY_COMMENTS=0
FB_GRAPH_VERSION=v21.0

# ---- กันสแปม / ความปลอดภัย (หน้าสาธารณะที่ไม่ต้องล็อกอิน) ----
RATE_PER_MIN=6
RATE_PER_HOUR=40
CHAT_PER_MIN=20
CHAT_PER_HOUR=200
# 1 เมื่อเปิดผ่าน Cloudflare Tunnel / proxy (ใช้ IP จริงของผู้ใช้จาก CF-Connecting-IP)
TRUST_PROXY=0
# ลิงก์ติดตามหมดอายุกี่วันหลังปิดเคสทุกเคส
TRACK_DAYS_AFTER_CLOSE=30
# รวมเคสซ้ำอัตโนมัติเมื่อคล้าย >= DUP_THRESHOLD · ระหว่าง SUGGEST..DUP ให้เจ้าหน้าที่ตัดสิน (ปรับจากผล eval_merge)
DUP_THRESHOLD=0.70
DUP_SUGGEST_THRESHOLD=0.40

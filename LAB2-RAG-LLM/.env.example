# Copy this file to ".env" and fill in your key. NEVER commit .env to GitHub.
LLM_PROVIDER=gemini

# Google AI Studio (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, free): install from https://ollama.com then `ollama pull qwen2.5:7b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
